<script>
/* --- 音效合成系統 (Web Audio API) --- */
const AudioContext = window.AudioContext || window.webkitAudioContext;
let audioCtx = null;
let isMuted = false;

function initAudio() {
    if (!audioCtx) {
        audioCtx = new AudioContext();
    }
    if (audioCtx.state === 'suspended') {
        audioCtx.resume();
    }
}

function playTone(freq, type, duration, vol=0.1) {
    if(isMuted || !audioCtx) return;
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.type = type;
    osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
    gain.gain.setValueAtTime(vol, audioCtx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + duration);
    osc.connect(gain);
    gain.connect(audioCtx.destination);
    osc.start();
    osc.stop(audioCtx.currentTime + duration);
}

const sounds = {
    correct: () => { playTone(600, 'sine', 0.1); setTimeout(() => playTone(800, 'sine', 0.15), 100); },
    wrong: () => { playTone(150, 'sawtooth', 0.3, 0.2); },
    attack: () => { playTone(100, 'square', 0.1, 0.3); setTimeout(() => playTone(50, 'square', 0.1, 0.2), 50); },
    heal: () => { playTone(400, 'sine', 0.1); setTimeout(() => playTone(500, 'sine', 0.1), 100); setTimeout(() => playTone(600, 'sine', 0.2), 200); },
    gameover: () => { playTone(300, 'sawtooth', 0.5); setTimeout(() => playTone(250, 'sawtooth', 0.8), 300); }
};

function toggleMute() {
    isMuted = !isMuted;
    document.getElementById('mute-btn').innerText = isMuted ? '🔇' : '🔊';
}

function toggleFullScreen() {
    if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen().catch(err => console.log(err));
    } else {
        document.exitFullscreen();
    }
}

/* --- 題庫資料 (小三程度, 涵蓋要求的標點) --- */
const rawQuestions = [
    { q: "早上___我吃了一個麵包___", a: ["，", "。"] },
    { q: "媽媽問___「你今天開心嗎___」", a: ["：", "？"] },
    { q: "公園裡有花___草和樹木___", a: ["、", "。"] },
    { q: "小明大叫___「救命啊___」", a: ["：", "！"] },
    { q: "我最喜歡看___西遊記___這本書___", a: ["《", "》", "。"] },
    { q: "哥哥喜歡踢球___弟弟喜歡看書___", a: ["；", "。"] },
    { q: "到底這件事是誰做的呢___", a: ["？"] },
    { q: "春天到了___花兒都開了___", a: ["，", "。"] },
    { q: "老師說___「大家安靜___」", a: ["：", "！"] },
    { q: "蘋果___橙和香蕉都是水果___", a: ["、", "。"] },
    { q: "天空突然變黑了___", a: ["……"] },
    { q: "你知道圖書館在哪裡嗎___", a: ["？"] },
    { q: "嘩___這座山真高啊___", a: ["！", "！"] },
    { q: "爸爸買了___哈利波特___給我們___", a: ["《", "》", "。"] },
    { q: "我有一隻小狗___牠叫小白___", a: ["，", "。"] },
    { q: "他很努力學習___所以成績很好___", a: ["，", "。"] },
    { q: "這裡的風景真美啊___", a: ["！"] },
    { q: "獅子___老虎和豹都是肉食動物___", a: ["、", "。"] },
    { q: "下雨了___我們快跑吧___", a: ["，", "！"] },
    { q: "姐姐問___「我可以借你的筆嗎___」", a: ["：", "？"] },
    { q: "我昨天去了海洋公園___", a: ["。"] },
    { q: "冰箱裡有牛奶___雞蛋和青菜___", a: ["、", "。"] },
    { q: "小紅喜歡唱歌___小明喜歡跳舞___", a: ["；", "。"] },
    { q: "救護車發出___鳴___鳴___的聲音___", a: ["「", "」", "。"] },
    { q: "你最喜歡什麼顏色___", a: ["？"] },
    { q: "哇___這個蛋糕太好吃了吧___", a: ["！", "！"] },
    { q: "經過不懈的努力___他終於成功了___", a: ["，", "。"] },
    { q: "我們要愛護環境___", a: ["。"] },
    { q: "媽媽語重心長地說___「你要做個誠實的孩子___」", a: ["：", "。"] },
    { q: "故事的情節真是跌宕起伏___", a: ["……"] }
];

const punctuations = ["，", "。", "、", "……", "；", "：", "？", "！", "「", "」", "《", "》"];
const monsterEmojis = ["👾", "🐉", "👹", "👻", "🦇", "🕷️", "🦂", "🦕"];

/* --- 遊戲邏輯與類別 --- */
class Player {
    constructor(idPrefix, name, emoji) {
        this.idPrefix = idPrefix;
        this.name = name;
        this.emoji = emoji;
        
        this.playerHP = 100;
        this.monsterHP = 100;
        this.score = 0;
        this.kills = 0;
        this.combo = 0;
        this.correctCount = 0;
        this.wrongCount = 0;
        
        this.baseAttack = 20;
        this.attackPower = 20;
        
        // 獨立題庫順序打亂
        this.questions = JSON.parse(JSON.stringify(rawQuestions)).sort(() => 0.5 - Math.random());
        this.currentQIndex = 0;
        this.currentAnswers = []; // 用戶選擇的答案暫存
        
        this.isDead = false;
        
        this.initKeyboard();
        this.spawnMonster();
        this.loadQuestion();
    }

    initKeyboard() {
        const kb = document.getElementById(`${this.idPrefix}-keyboard`);
        kb.innerHTML = '';
        punctuations.forEach(p => {
            const btn = document.createElement('button');
            btn.className = 'key-btn';
            btn.innerText = p;
            btn.onclick = () => this.typePunctuation(p);
            kb.appendChild(btn);
        });
    }

    spawnMonster() {
        this.monsterHP = 100;
        const randomMonster = monsterEmojis[Math.floor(Math.random() * monsterEmojis.length)];
        document.getElementById(`${this.idPrefix}-monster`).innerText = randomMonster;
        this.updateUI();
    }

    loadQuestion() {
        if (this.currentQIndex >= this.questions.length) {
            this.currentQIndex = 0; // 循環題庫
            this.questions.sort(() => 0.5 - Math.random());
        }
        
        const qData = this.questions[this.currentQIndex];
        this.currentAnswers = new Array(qData.a.length).fill(null);
        this.renderQuestionBox();
    }

    renderQuestionBox() {
        const qData = this.questions[this.currentQIndex];
        const parts = qData.q.split("___");
        const qBox = document.getElementById(`${this.idPrefix}-question`);
        qBox.innerHTML = '';
        
        for (let i = 0; i < parts.length; i++) {
            qBox.appendChild(document.createTextNode(parts[i]));
            if (i < parts.length - 1) {
                const span = document.createElement('span');
                span.className = 'blank';
                span.innerText = this.currentAnswers[i] ? this.currentAnswers[i] : '';
                qBox.appendChild(span);
            }
        }
    }

    typePunctuation(p) {
        if(this.isDead) return;
        // 找到第一個還沒填的空格
        const emptyIndex = this.currentAnswers.indexOf(null);
        if (emptyIndex !== -1) {
            this.currentAnswers[emptyIndex] = p;
            this.renderQuestionBox();
        }
    }

    cancelInput() {
        if(this.isDead) return;
        this.currentAnswers.fill(null);
        this.renderQuestionBox();
    }

    confirmInput() {
        if(this.isDead) return;
        if (this.currentAnswers.includes(null)) {
            alert("請填滿所有空格！");
            return;
        }

        const qData = this.questions[this.currentQIndex];
        let isCorrect = true;
        for (let i = 0; i < qData.a.length; i++) {
            if (this.currentAnswers[i] !== qData.a[i]) {
                isCorrect = false;
                break;
            }
        }

        if (isCorrect) {
            this.handleCorrect();
        } else {
            this.handleWrong();
        }
    }

    handleCorrect() {
        sounds.correct();
        this.correctCount++;
        this.score += 10;
        this.combo++;
        
        let dmg = this.attackPower;

        // Combo 獎勵
        if (this.combo >= 3) {
            sounds.heal();
            this.playerHP = Math.min(100, this.playerHP + 20);
            dmg = this.baseAttack * 2; // 攻擊力翻倍
            this.combo = 0; // 重置
            this.showComboText("Combo! 回血+爆擊!");
            this.animTrigger(`${this.idPrefix}-sprite`, 'heal-anim');
        } else {
            this.showComboText(`Combo x${this.combo}`);
        }

        // 攻擊動畫與傷害計算
        setTimeout(() => {
            sounds.attack();
            this.animTrigger(`${this.idPrefix}-sprite`, 'attack-anim');
            this.animTrigger(`${this.idPrefix}-monster`, 'hit-anim');
            
            this.monsterHP -= dmg;
            if (this.monsterHP <= 0) {
                this.kills++;
                this.score += 20; // 擊殺獎勵
                setTimeout(() => this.spawnMonster(), 500);
            }
            this.updateUI();
            
            this.currentQIndex++;
            this.loadQuestion();
        }, 300);
    }

    handleWrong() {
        sounds.wrong();
        this.wrongCount++;
        this.combo = 0;
        this.playerHP -= 15;
        this.showComboText("Combo 中斷!", "#e74c3c");
        
        this.animTrigger(`${this.idPrefix}-monster`, 'attack-anim');
        setTimeout(() => {
            this.animTrigger(`${this.idPrefix}-sprite`, 'hit-anim');
            this.updateUI();
            this.cancelInput(); // 清空重答
            
            if (this.playerHP <= 0) {
                this.playerHP = 0;
                this.isDead = true;
                checkGameOver();
            }
        }, 300);
    }

    updateUI() {
        document.getElementById(`${this.idPrefix}-score`).innerText = this.score;
        document.getElementById(`${this.idPrefix}-kills`).innerText = this.kills;
        document.getElementById(`${this.idPrefix}-hp-bar`).style.width = `${Math.max(0, this.playerHP)}%`;
        document.getElementById(`${this.idPrefix}-monster-hp-bar`).style.width = `${Math.max(0, this.monsterHP)}%`;
    }

    animTrigger(elementId, animClass) {
        const el = document.getElementById(elementId);
        el.classList.remove(animClass);
        void el.offsetWidth; // trigger reflow
        el.classList.add(animClass);
    }

    showComboText(text, color="#f1c40f") {
        const comboEl = document.getElementById(`${this.idPrefix}-combo`);
        comboEl.innerText = text;
        comboEl.style.color = color;
        comboEl.classList.remove('show-combo');
        void comboEl.offsetWidth;
        comboEl.classList.add('show-combo');
    }
}

let players = [];

function startGame() {
    initAudio();
    document.getElementById('start-screen').classList.add('hidden');
    document.getElementById('battle-screen').classList.remove('hidden');
    
    players = [
        new Player('p1', '騎士', '🛡️'),
        new Player('p2', '法師', '🪄')
    ];
}

function checkGameOver() {
    // 當任意一位玩家 HP 歸零時，遊戲結束，比較分數
    if (players[0].isDead || players[1].isDead) {
        sounds.gameover();
        setTimeout(showResult, 1000);
    }
}

function showResult() {
    document.getElementById('battle-screen').classList.add('hidden');
    document.getElementById('end-screen').classList.remove('hidden');
    
    const tbody = document.getElementById('result-body');
    tbody.innerHTML = '';
    
    let winner = "平手！";
    if (players[0].score > players[1].score) winner = "🏆 騎士獲勝！";
    else if (players[1].score > players[0].score) winner = "🏆 法師獲勝！";
    
    document.getElementById('winner-announcement').innerText = winner;

    players.forEach(p => {
        const tr = document.createElement('tr');
        tr.innerHTML = `
            <td>${p.name} ${p.emoji}</td>
            <td style="color:#f1c40f; font-weight:bold;">${p.score}</td>
            <td style="color:#2ecc71;">${p.correctCount}</td>
            <td style="color:#e74c3c;">${p.wrongCount}</td>
            <td style="color:#e67e22;">${p.kills}</td>
        `;
        tbody.appendChild(tr);
    });
}

</script>
