<!DOCTYPE html>
<html lang="zh-HK">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>標點符號保衛戰</title>
    <style>
        :root {
            --bg-color: #1a1a2e;
            --panel-bg: #16213e;
            --primary-border: #0f3460;
            --text-color: #e94560;
            --hp-green: #4cd137;
            --hp-red: #e84118;
            --btn-bg: #2f3640;
            --btn-hover: #353b48;
            --blank-color: #f5f6fa;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
            font-family: 'Microsoft JhengHei', 'PingFang HK', sans-serif;
        }

        body {
            background-color: #000;
            color: white;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }

        #game-container {
            width: 100vw;
            height: 100vh;
            background-color: var(--bg-color);
            position: relative;
            display: flex;
            flex-direction: column;
            aspect-ratio: 16/9;
            max-width: 177.77vh; /* 維持 16:9 */
            margin: auto;
            border: 2px solid #333;
        }

        /* 首頁與結算頁 */
        .screen {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(26, 26, 46, 0.95);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 100;
        }

        .hidden {
            display: none !important;
        }

        h1 {
            font-size: 5vw;
            color: #f1c40f;
            text-shadow: 2px 2px 10px rgba(241, 196, 15, 0.5);
            margin-bottom: 20px;
        }

        .instructions {
            font-size: 2vw;
            line-height: 1.5;
            text-align: center;
            margin-bottom: 40px;
            background: rgba(0,0,0,0.5);
            padding: 20px;
            border-radius: 15px;
            border: 2px solid var(--primary-border);
        }

        .start-btn {
            font-size: 3vw;
            padding: 15px 50px;
            background-color: #e94560;
            color: white;
            border: none;
            border-radius: 50px;
            cursor: pointer;
            box-shadow: 0 5px 15px rgba(233, 69, 96, 0.4);
            transition: transform 0.1s;
        }
        .start-btn:active { transform: scale(0.95); }

        /* 全域按鈕 (全屏, 靜音) */
        .global-controls {
            position: absolute;
            top: 10px;
            right: 20px;
            z-index: 200;
            display: flex;
            gap: 15px;
        }

        .icon-btn {
            background: rgba(255,255,255,0.1);
            border: 2px solid #fff;
            color: white;
            font-size: 1.5vw;
            width: 3vw;
            height: 3vw;
            border-radius: 50%;
            cursor: pointer;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        /* 遊戲主畫面 */
        #battle-screen {
            display: flex;
            width: 100%;
            height: 100%;
            flex-direction: row;
        }

        .player-panel {
            flex: 1;
            display: flex;
            flex-direction: column;
            padding: 1vw;
            border-right: 4px solid #000;
            background: var(--panel-bg);
        }
        .player-panel:last-child { border-right: none; }

        /* 頂部資訊區 */
        .status-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1vh;
            font-size: 1.5vw;
            font-weight: bold;
        }
        .player-name { color: #3498db; }
        .p2-name { color: #9b59b6; }

        .hp-container {
            width: 45%;
        }
        .hp-label { font-size: 1vw; margin-bottom: 5px; }
        .hp-bar-bg {
            width: 100%;
            height: 2vh;
            background: #333;
            border-radius: 10px;
            overflow: hidden;
            border: 2px solid #555;
        }
        .hp-bar-fill {
            height: 100%;
            background: var(--hp-green);
            width: 100%;
            transition: width 0.3s ease;
        }
        .monster-hp .hp-bar-fill { background: var(--hp-red); }

        /* 戰鬥畫面區 */
        .arena {
            flex: 2;
            background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" viewBox="0 0 100 100"><rect width="100" height="100" fill="%232c3e50"/><path d="M0 80 Q 25 70, 50 80 T 100 80" fill="none" stroke="%2334495e" stroke-width="20"/></svg>') bottom/cover;
            border-radius: 15px;
            border: 3px solid #0f3460;
            display: flex;
            justify-content: space-around;
            align-items: flex-end;
            padding-bottom: 2vh;
            position: relative;
            margin-bottom: 1vh;
        }

        .sprite {
            font-size: 6vw;
            filter: drop-shadow(0 10px 5px rgba(0,0,0,0.5));
            transition: transform 0.2s;
        }
        .monster-sprite { font-size: 7vw; }

        /* 動畫效果 */
        .attack-anim { animation: attackMove 0.3s ease-in-out; }
        .hit-anim { animation: shake 0.3s; filter: brightness(2) drop-shadow(0 0 10px red); }
        .heal-anim { animation: bounce 0.5s; filter: brightness(1.5) drop-shadow(0 0 10px green); }
        
        @keyframes attackMove {
            0% { transform: translateX(0); }
            50% { transform: translateX(5vw); }
            100% { transform: translateX(0); }
        }
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-1vw); }
            75% { transform: translateX(1vw); }
        }
        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-3vh); }
        }

        .combo-text {
            position: absolute;
            top: 10px;
            left: 50%;
            transform: translateX(-50%);
            font-size: 2vw;
            font-weight: bold;
            color: #f1c40f;
            text-shadow: 0 0 10px #d35400;
            opacity: 0;
            transition: opacity 0.3s;
        }
        .show-combo { opacity: 1; animation: bounce 0.5s; }

        /* 題目區 */
        .question-box {
            flex: 1.5;
            background: #fff;
            color: #000;
            border-radius: 15px;
            padding: 2vh 2vw;
            font-size: 2.2vw;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1vh;
            border: 4px solid #f1c40f;
            font-weight: bold;
            line-height: 1.5;
            text-align: center;
        }
        .blank {
            display: inline-block;
            min-width: 3vw;
            height: 3vw;
            border-bottom: 4px solid #e74c3c;
            margin: 0 5px;
            text-align: center;
            color: #e74c3c;
            vertical-align: bottom;
        }

        /* 鍵盤區 */
        .keyboard {
            flex: 2;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1vw;
            margin-bottom: 1vh;
        }
        .key-btn {
            background: var(--btn-bg);
            color: white;
            font-size: 2.5vw;
            font-weight: bold;
            border: 2px solid #555;
            border-radius: 10px;
            cursor: pointer;
            display: flex;
            justify-content: center;
            align-items: center;
            box-shadow: 0 4px 0 #111;
        }
        .key-btn:active {
            transform: translateY(4px);
            box-shadow: 0 0 0 #111;
        }

        /* 操作按鈕區 */
        .actions {
            flex: 0.8;
            display: flex;
            gap: 1vw;
        }
        .action-btn {
            flex: 1;
            font-size: 1.8vw;
            font-weight: bold;
            border-radius: 10px;
            border: none;
            cursor: pointer;
            color: white;
            box-shadow: 0 4px 0 #111;
        }
        .action-btn:active { transform: translateY(4px); box-shadow: 0 0 0 #111; }
        .btn-cancel { background-color: #7f8c8d; }
        .btn-confirm { background-color: #27ae60; }

        /* 結算頁面表格 */
        .result-table {
            font-size: 2vw;
            margin: 20px 0;
            width: 80%;
            text-align: center;
            border-collapse: collapse;
        }
        .result-table th, .result-table td {
            border: 2px solid #fff;
            padding: 10px;
        }
        .result-table th { background: #0f3460; }
        
        .winner-text {
            font-size: 4vw;
            color: #f1c40f;
            margin-bottom: 20px;
            animation: bounce 1s infinite;
        }

    </style>
</head>
<body>

    <div id="game-container">
        
        <!-- 全域控制 -->
        <div class="global-controls">
